# Copy this file to .env in the project root. Never commit .env or share its values.
# Google Cloud project: enable Maps JavaScript API, Places API (New), and Routes API.
MAPS_PROVIDER=google
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_ROUTES_API_KEY=

# Browser key: restrict by HTTP referrer (http://localhost:8000/* and
# http://127.0.0.1:8000/*) and allow Maps JavaScript API + Places API (New).
# Routes key: restrict to Routes API. This key is only used by the backend.
